[global]
    font = JetBrainsMono Nerd Font 11
    background = "#181825"
    foreground = "#cdd6f4"
    frame_color = "#74c7ec"
    frame_width = 2
    corner_radius = 8
    origin = top-center

[urgency_low]
    background = "#181825"
    foreground = "#cdd6f4"
    frame_color = "#89dceb"
    timeout = 5

[urgency_normal]
    background = "#181825"
    foreground = "#cdd6f4"
    frame_color = "#74c7ec"
    timeout = 10

[urgency_critical]
    background = "#181825"
    foreground = "#cdd6f4"
    frame_color = "#f38ba8"
    timeout = 0
